# Claude API (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: troque para claude-opus-5 se quiser resumos de mais qualidade (custa mais)
ANTHROPIC_MODEL=claude-haiku-4-5

# Telegram (crie o bot no @BotFather e adicione como admin do canal)
TELEGRAM_BOT_TOKEN=123456:ABC-...
# "@seucanal" ou o ID numérico (-100xxxxxxxxxx)
TELEGRAM_CHANNEL_ID=@seucanal

# Supabase (Settings -> API). Use a service_role key, NUNCA a anon em produção.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Link de afiliado da Binx (com seu codigo de referencia)
BINX_AFFILIATE_URL=https://www.binx.com/register?ref=SEU_CODIGO

# URL publica do servico no Railway (para os links /go rastreados)
PUBLIC_BASE_URL=https://binx-news-bot.up.railway.app

# Opcionais
# PORT=3000
# CRON_SCHEDULE=*/15 * * * *
# MAX_POSTS_PER_CYCLE=3
# MIN_IMPORTANCE=3
